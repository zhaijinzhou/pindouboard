/* pages/cabinet/cabinet.wxss */

/* ============ 统计 ============ */
.stat-row {
  display: flex;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-brand);
  margin-bottom: 4rpx;
}
.stat-label {
  display: block;
  font-size: 21rpx;
  color: var(--c-text-3);
}

/* ============ 录入标签 ============ */
.entry-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.entry-tab {
  flex: 1;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f6f7f9;
  border: 3rpx solid transparent;
  text-align: center;
  transition: all 0.15s;
}
.entry-tab.active {
  background: var(--c-brand-soft);
  border-color: var(--c-brand);
}
.entry-tab-icon {
  display: block;
  font-size: 34rpx;
  margin-bottom: 8rpx;
}
.entry-tab-name {
  font-size: 24rpx;
  color: var(--c-text-2);
}
.entry-tab.active .entry-tab-name {
  color: var(--c-brand);
  font-weight: 600;
}

/* ============ 输入 ============ */
.input-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}
.code-input {
  flex: 1.4;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.qty-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.ph {
  color: var(--c-text-3);
  font-size: 24rpx;
}
.add-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
}

/* ============ 库存列表 ============ */
.inv-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}
.inv-item:last-child {
  border-bottom: none;
}
.inv-swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  margin-right: 18rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}
.inv-text {
  flex: 1;
  min-width: 0;
}
.inv-code {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
}
.inv-name {
  display: block;
  font-size: 21rpx;
  color: var(--c-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}